# Dokan v3 — Environment Variables
# Copy to .env.local and fill in real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel (optional — for CI/deploy preview DB connections)
DATABASE_URL=postgresql://...
VERCEL_OIDC_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://dokanstore.xyz

# Push Notifications (Web VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJ...
VAPID_PRIVATE_KEY=...
VAPID_CONTACT=mailto:admin@example.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=123:abc
TELEGRAM_BOT_USERNAME=@your_bot
TELEGRAM_WEBHOOK_SECRET=<random hex 64 chars>

# Monitoring (Sentry)
SENTRY_DSN=https://...@....ingest.sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_...
