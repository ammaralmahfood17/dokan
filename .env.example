# Dokan v3 — Environment Variables
# Copy to .env.local and fill in real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel (optional — for CI/deploy preview DB connections)
DATABASE_URL=postgresql://...
VERCEL_OIDC_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://dokanstore.xyz

# Push Notifications (Web VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BJ...
VAPID_PRIVATE_KEY=...
VAPID_CONTACT=mailto:admin@example.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=123:abc
TELEGRAM_BOT_USERNAME=@your_bot
TELEGRAM_WEBHOOK_SECRET=<random hex 64 chars>

# ─── Public write protection (audit 2026-10) ────────────────────────────────
# The table scan token (tables.qrcode, 128-bit) is verified INSIDE the database by
# resolve_table_by_token. This flag decides whether a token is REQUIRED to order.
# Owner decision 1: keep it FALSE until tokenless orders (token_present=false) have been
# zero for 48h — the flip is data-driven, never date-based.
REQUIRE_TABLE_TOKEN=false
# Records token_present on every public order, which is what drives the flip above.
ORDERS_TOKEN_TELEMETRY=true
# Ops-only token for /api/health and /api/vitals. Generate with: openssl rand -hex 32
# REQUIRED in production (decision 8): without it the health endpoint answers anyone.
HEALTH_TOKEN=

# ─── Cloudflare Turnstile — signup bot protection (owner decision 7/8) ──────
# Both values are REQUIRED in production; boot-time validation fails closed without them
# and POST /api/auth/signup refuses to create accounts. Get them from the Turnstile
# dashboard (Add site → the site key is public, the secret is not).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET=0x4AAAAAAA...

# Monitoring (Sentry)
SENTRY_DSN=https://...@....ingest.sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_...
